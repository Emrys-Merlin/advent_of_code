[project]
name = "aoc{{ year }}"
version = "0.1.0"
description = "Python solutions for Advent of Code {{ year }}"
requires-python = "~={{ python_version }}.0"
dependencies = [
    # aoc-lib is a local Rust extension built by pixi: see [tool.pixi.dependencies]
]

[dependency-groups]
dev = ["pytest", "ruff", "ty"]

[project.scripts]
aoc{{ year }} = "aoc{{ year }}:cli"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pixi.workspace]
channels = ["https://prefix.dev/conda-forge"]
platforms = ["linux-64", "osx-arm64"]
preview = ["pixi-build"]

[tool.pixi.dependencies]
aoc-lib = { path = "../../aoc_lib" }

[tool.pixi.pypi-dependencies]
aoc{{ year }} = { path = ".", editable = true }

[tool.pixi.environments]
default = { features = ["dev"], solve-group = "default" }

[tool.pixi.tasks]
test = "pytest"
lint = "ruff check"
typecheck = "ty check"
